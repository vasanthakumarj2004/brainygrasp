# ============================================================
# BrainyGrasp — PRODUCTION Environment Variables Template
# Copy this file as .env and fill in your real values.
# NEVER commit .env to Git — it is listed in .gitignore.
# ============================================================

# ── Email ────────────────────────────────────────────────────
# Gmail SMTP via Nodemailer (local and AWS deployment).
# Use an app password for this Gmail account, not its normal account password.
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-character-app-password
# SMTP uses smtp.gmail.com:465 with TLS. Restart after changing credentials.
# Verify without sending email: npm run email:verify (from backend/).

# ── JWT ──────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET

# ── PostgreSQL (choose ONE block) ────────────────────────────

# OPTION A — Cloud (Neon / Supabase / Railway):
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OPTION B — Local Docker (comment out DATABASE_URL above):
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=brainygras
# DB_PASSWORD=your_password
# DB_PORT=5432

# ── Redis (choose ONE block) ─────────────────────────────────

# OPTION A — Cloud (Upstash):
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@your-url.upstash.io:6379

# OPTION B — Local Docker (comment out REDIS_URL above):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# ── Environment ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000
SERVE_FRONTEND=true

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API.
# Required in production. Local development can use its own ignored .env.
FRONTEND_URL=https://brainygrasp.com
ALLOWED_ORIGINS=https://brainygrasp.com,https://www.brainygrasp.com

# ── Razorpay ─────────────────────────────────────────────────
# Use rzp_test_ keys for testing, rzp_live_ keys after approval.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET
# Independent random secret (at least 32 characters). Configure the same secret
# at https://brainygrasp.com/api/webhooks/razorpay for payment.captured and order.paid.
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

# ── Admin Panel ───────────────────────────────────────────────
# ⚠️  REQUIRED — the server will NOT start if these are missing.
# There are no fallback defaults. Use a strong, unique password.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_admin_password

# ── Shiprocket ─────────────────────────────────────────────────
# Dedicated Shiprocket API-user credentials (not the main dashboard login).
# Keep false until measured products, real boxes, credentials and webhooks are ready.
SHIPROCKET_ENABLED=false
SHIPROCKET_EMAIL=your_shiprocket@email.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# Channel ID — find it in Shiprocket > Settings > Channels.
SHIPROCKET_CHANNEL_ID=123456

# Pickup location name — must match exactly as set in Shiprocket > Settings > Manage Pickups.
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_POSTCODE=replace_with_6_digit_pickup_pin
# Unique nonzero 1-8 digit prefix for this store/environment. Keep it stable.
SHIPROCKET_ORDER_PREFIX=replace_with_unique_numeric_prefix
# Real measured boxes only. See SHIPPING_SETUP.md for the complete JSON format.
# No default dimensions or weights are assumed. Empty list blocks live startup.
SHIPROCKET_PACKAGES=[]

# Webhook secret — add a strong random string; configure the same value in
# Shiprocket > Settings > API > Webhooks as the x-api-key security token.
# URL: https://YOUR_BACKEND/api/delivery-events (POST)
SHIPROCKET_WEBHOOK_SECRET=replace_with_strong_random_secret
