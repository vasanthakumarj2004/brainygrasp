# ==============================================================================
# BrainyGrasp AWS Production Environment Variables Template
# ==============================================================================

# Server Environment & Port Configuration
NODE_ENV=production
PORT=3000
SERVE_FRONTEND=true

# CORS & Domain Settings
FRONTEND_URL=https://brainygrasp.com
ALLOWED_ORIGINS=https://brainygrasp.com,https://www.brainygrasp.com

# PostgreSQL Database Configuration (AWS RDS PostgreSQL)
# Option A: Full Connection String (Recommended for RDS / Neon / Managed DB)
DATABASE_URL=postgresql://db_user:db_password@rds-instance-endpoint.rds.amazonaws.com:5432/brainygrasp_db?sslmode=require

# Option B: Individual Connection Credentials (if DATABASE_URL is not set)
DB_HOST=rds-instance-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=brainygrasp_db
DB_USER=db_user
DB_PASSWORD=db_password
DB_SSL=true

# Redis Cache & Session Storage (AWS ElastiCache / Upstash Redis)
REDIS_URL=redis://default:redis_password@elasticache-endpoint.cache.amazonaws.com:6379
# Fallback Redis fields if REDIS_URL is not used:
REDIS_HOST=elasticache-endpoint.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# Authentication & Security Secrets
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD=replace_with_unique_admin_password

# Payment Gateway (Razorpay - Production Key ID & Secret)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=replace_with_independent_random_secret_at_least_32_characters
# Live webhook: https://brainygrasp.com/api/webhooks/razorpay
# Subscribe to payment.captured and order.paid; enable automatic capture.

# Shipping Integration (Shiprocket API Credentials)
SHIPROCKET_ENABLED=false
SHIPROCKET_EMAIL=shipping@your-domain.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_CHANNEL_ID=replace_with_channel_id
SHIPROCKET_PICKUP_LOCATION=replace_with_pickup_name
SHIPROCKET_PICKUP_POSTCODE=replace_with_pickup_pin
SHIPROCKET_ORDER_PREFIX=replace_with_unique_numeric_prefix
SHIPROCKET_PACKAGES=[]
SHIPROCKET_WEBHOOK_SECRET=replace_with_random_secret_at_least_32_characters
# Tracking webhook: POST /api/delivery-events, secret in x-api-key.
# See backend/SHIPPING_SETUP.md; do not enable with example measurements.

# OTP Email (Nodemailer / Gmail SMTP, local and AWS)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-character-app-password
# Supply these to the backend runtime; SMTP uses TLS on outbound port 465.
